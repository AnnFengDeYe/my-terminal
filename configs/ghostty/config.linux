# ==========================================
# Ghostty Linux / Raspberry Pi 配置
# ==========================================

# Linux 桌面和 Raspberry Pi 屏幕通常更小；macOS 配置保持在 configs/ghostty/config。
font-size = 14
font-family = "JetBrainsMono Nerd Font Mono"

# macOS 配置是 110 x 35；Linux/Raspberry Pi 使用 70 x 20，适合小屏桌面。
window-width = 70
window-height = 20

# Linux 上显式启用 GTK 原生标题栏，让窗口管理器显示关闭/最小化/最大化按钮。
window-decoration = client
gtk-titlebar = true
gtk-titlebar-style = native
gtk-toolbar-style = raised-border

cursor-style = bar
cursor-style-blink = true

theme = 0x96f
background-opacity = 0.9
background-blur-radius = 20

keybind = ctrl+shift+r=reload_config

term = xterm-256color
