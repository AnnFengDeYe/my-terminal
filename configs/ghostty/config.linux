# ==========================================
# Ghostty Linux / Raspberry Pi 配置
# ==========================================

# Linux 桌面和 Raspberry Pi 屏幕通常更小；macOS 配置保持在 configs/ghostty/config。
font-size = 14
font-family = "JetBrainsMono Nerd Font Mono"

# macOS 配置是 110 x 35；Linux 默认减半，适合小屏桌面。
window-width = 55
window-height = 18

cursor-style = bar
cursor-style-blink = true

theme = 0x96f
background-opacity = 0.9
background-blur-radius = 20

keybind = ctrl+shift+r=reload_config

term = xterm-256color
