# ------------------------------------------
# fzf：模糊搜索与交互式选择
# ------------------------------------------

if command -v fzf >/dev/null 2>&1; then

  # 使用 fd 作为 fzf 默认文件搜索引擎
  # 默认不搜索隐藏文件，避免 .zsh_sessions / .cache / .cmake 等噪音
  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --follow --exclude .git --exclude node_modules --exclude .cache --exclude .cmake --exclude .zsh_sessions --exclude Library'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

    export FZF_ALT_C_COMMAND='fd --type d --follow --exclude .git --exclude node_modules --exclude .cache --exclude .cmake --exclude .zsh_sessions --exclude Library'
  fi

  # fzf 默认界面样式
  export FZF_DEFAULT_OPTS='
    --height 40%
    --layout=reverse
    --border
    --inline-info
  '

  # Ctrl+T：搜索文件时使用 bat 预览
  if command -v bat >/dev/null 2>&1; then
    export FZF_CTRL_T_OPTS='
      --preview "bat --color=always --style=numbers --line-range=:300 {}"
      --preview-window=right:60%:wrap
    '
  fi

  # Alt+C：搜索目录时使用 eza 预览
  if command -v eza >/dev/null 2>&1; then
    export FZF_ALT_C_OPTS='
      --preview "eza --tree --level=2 --icons=always --git-ignore {}"
      --preview-window=right:60%:wrap
    '
  fi

  # ff：手动进入“包含隐藏文件”的全量文件搜索
  # 适合查找 .zshrc / .config / starship.toml 等配置文件
  if command -v fd >/dev/null 2>&1 && command -v bat >/dev/null 2>&1; then
    alias ff='fd --type f --hidden --follow --exclude .git --exclude node_modules --exclude .cache --exclude .cmake --exclude .zsh_sessions --exclude Library | fzf --preview "bat --color=always --style=numbers --line-range=:300 {}" --preview-window=right:60%:wrap'
  fi

  # 加载 fzf shell 集成
  if [ -f "$HOME/.fzf.zsh" ]; then
    source "$HOME/.fzf.zsh"
  elif command -v brew >/dev/null 2>&1; then
    FZF_BASE="$(brew --prefix)/opt/fzf/shell"

    [ -f "$FZF_BASE/key-bindings.zsh" ] && source "$FZF_BASE/key-bindings.zsh"
    [ -f "$FZF_BASE/completion.zsh" ] && source "$FZF_BASE/completion.zsh"
  fi

fi

# ------------------------------------------
# fd：现代 find 替代
# ------------------------------------------

if command -v fd >/dev/null 2>&1; then
  alias find="fd"                                  # 替代 find，语法更简洁
  alias fda="fd --hidden --follow --exclude .git" # 搜索全部，包含隐藏文件
  alias fdd="fd --type d"                         # 只搜索目录
  alias fdf="fd --type f"                         # 只搜索文件
  alias fchanged="fd --changed-within"            # 按时间查找近期改动
fi

# ------------------------------------------
# ripgrep：现代 grep 替代
# ------------------------------------------

if command -v rg >/dev/null 2>&1; then
  alias grep="rg"    # 替代 grep，搜索更快
  alias rgi="rg -i"  # 忽略大小写搜索

  rgc() {            # 带上下文行数搜索
    if [ "$#" -ne 2 ]; then
      echo "Usage: rgc <context_lines> <search_text>"
      echo "Example: rgc 2 'TODO'"
      return 1
    fi

    case "$1" in
      ''|*[!0-9]*)
        echo "context_lines must be a non-negative integer"
        return 1
        ;;
    esac

    rg -C "$1" -- "$2"
  }

  rga() {            # 搜索全部，包含隐藏文件
    rg --hidden --follow \
      --glob '!.git' \
      --glob '!node_modules' \
      --glob '!.cache' \
      "$@"
  }
fi

# ------------------------------------------
# Yazi：终端文件管理器
# ------------------------------------------

if command -v yazi >/dev/null 2>&1; then
  y() {
    local tmp cwd
    tmp="${TMPDIR:-/tmp}/yazi-cwd.$$"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp" 2>/dev/null)" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
      builtin cd -- "$cwd"
    fi
    command rm -f -- "$tmp"
  }
fi

# ------------------------------------------
# Git：交互式分支切换
# ------------------------------------------

if command -v git >/dev/null 2>&1 && command -v fzf >/dev/null 2>&1; then
  gsw() {            # 使用 fzf 选择并切换 Git 分支
    local branch

    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      echo "gsw: not inside a git repository" >&2
      return 1
    fi

    branch="$(
      git for-each-ref --format='%(refname:short)' refs/heads refs/remotes/origin \
        | sed 's#^origin/##' \
        | sed '/^HEAD$/d' \
        | sort -u \
        | fzf --prompt='git switch> ' --preview 'branch={}
if git show-ref --verify --quiet "refs/heads/$branch"; then
  git log --oneline --graph --decorate --color=always --max-count=20 "$branch"
elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
  git log --oneline --graph --decorate --color=always --max-count=20 "origin/$branch"
else
  echo "No commits found for $branch"
fi'
    )" || return

    [ -n "$branch" ] || return 0

    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git switch "$branch"
    elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git switch --track "origin/$branch"
    else
      echo "gsw: branch not found: $branch" >&2
      return 1
    fi
  }
fi

# ------------------------------------------
# fkill：交互式进程终止
# ------------------------------------------

if command -v fzf >/dev/null 2>&1 && command -v pstree >/dev/null 2>&1 && { command -v bat >/dev/null 2>&1 || command -v batcat >/dev/null 2>&1; }; then
  _fkill_ps_cmd() {
    if ps --version >/dev/null 2>&1; then
      printf '%s\n' "ps -eo pid,ppid,user,stat,pcpu,pmem,comm,args --sort=-pcpu | sed 's/^[[:space:]]*//'"
    else
      printf '%s\n' "{ ps -axo pid,ppid,user,stat,%cpu,%mem,comm,args | head -n 1; ps -axo pid,ppid,user,stat,%cpu,%mem,comm,args | tail -n +2 | sort -k5 -nr; } | sed 's/^[[:space:]]*//'"
    fi
  }

  _fkill_ps_list() {
    if ps --version >/dev/null 2>&1; then
      ps -eo pid,ppid,user,stat,pcpu,pmem,comm,args --sort=-pcpu | sed 's/^[[:space:]]*//'
    else
      {
        ps -axo pid,ppid,user,stat,%cpu,%mem,comm,args | head -n 1
        ps -axo pid,ppid,user,stat,%cpu,%mem,comm,args | tail -n +2 | sort -k5 -nr
      } | sed 's/^[[:space:]]*//'
    fi
  }

  _fkill_run() {
    local prompt ps_cmd preview pids signal
    signal="$1"
    prompt="$2"
    ps_cmd="$(_fkill_ps_cmd)"
    preview='
signal="'"$signal"'"
pid={1}
bat_cmd="bat"
if ! command -v "$bat_cmd" >/dev/null 2>&1; then
  bat_cmd="batcat"
fi

info="$(ps -p "$pid" -o pid,ppid,user,stat,pcpu,pmem,comm,args 2>/dev/null || \
ps -p "$pid" -o pid,ppid,user,stat,%cpu,%mem,comm,args 2>/dev/null || \
printf "Process not found\n")"

tree="$(pstree -p "$pid" 2>/dev/null || pstree "$pid" 2>/dev/null || printf "No process tree available\n")"

if command -v lsof >/dev/null 2>&1; then
  ports="$(lsof -Pan -p "$pid" -i 2>/dev/null | head -n 20)"
  files="$(lsof -p "$pid" 2>/dev/null | head -n 20)"
else
  ports=""
  files=""
fi

{
  printf "# Process `%s`\n\n" "$pid"
  printf "- Signal: `%s`\n" "$signal"
  printf "- Search scope: `COMM/ARGS`\n\n"

  printf "## Process Info\n\n"
  printf "```text\n%s\n```\n\n" "$info"

  printf "## Process Tree\n\n"
  printf "```text\n%s\n```\n\n" "$tree"

  printf "## Network Ports\n\n"
  if [ -n "$ports" ]; then
    printf "```text\n%s\n```\n\n" "$ports"
  else
    printf "_No network ports, permission denied, or lsof unavailable._\n\n"
  fi

  printf "## Open Files\n\n"
  if [ -n "$files" ]; then
    printf "```text\n%s\n```\n" "$files"
  else
    printf "_No open files, permission denied, or lsof unavailable._\n"
  fi
} | "$bat_cmd" --language=markdown --style=plain --color=always --paging=never'

    pids="$(
      _fkill_ps_list \
        | fzf \
          --ansi \
          --border \
          --height=90% \
          --layout=reverse \
          --header-lines=1 \
          --multi \
          --delimiter='[[:space:]]+' \
          --nth=7.. \
          --header='Search COMM/ARGS only | Tab multi-select | Ctrl-R refresh | Enter kill' \
          --prompt="$prompt" \
          --preview "$preview" \
          --preview-window=right:65%:wrap \
          --bind "ctrl-r:reload($ps_cmd)" \
          --bind 'ctrl-j:preview-down,ctrl-k:preview-up' \
          --bind 'ctrl-d:preview-page-down,ctrl-u:preview-page-up' \
        | awk '{print $1}'
    )"

    [ -n "$pids" ] || return 0
    printf '%s\n' "$pids" | xargs kill "$signal"
  }

  fkill() {
    _fkill_run -TERM "Kill Process > "
  }

  fkill9() {
    _fkill_run -KILL "Force Kill Process > "
  }
fi

